OPENAI_API_KEY=
FIRECRAWL_API_KEY=
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
DEEPGRAM_API_KEY=

# Optional. Keys are read from the repo-root .env first, then backend/.env.
# PUBLIC_API_BASE_URL=              # only scripts/deepgram-chat.py reads this (or pass API=)
# KIBANA_URL=                       # blank derives it from ELASTICSEARCH_URL (.es. -> .kb.)
# AGENT_BUILDER_ENABLED=true
# AGENT_BUILDER_AGENT_ID=peel-research-agent
# AGENT_BUILDER_CONNECTOR_ID=.anthropic-claude-5-sonnet-chat_completion
# AGENT_BUILDER_TIMEOUT_S=120
# AGENT_BUILDER_FIRECRAWL_CONNECTOR_ID=   # set only to let the agent call Firecrawl itself (uncapped credits)
# SEMANTIC_SCORE_THRESHOLD=0.70
# FIRECRAWL_ENABLED=true
# FIRECRAWL_MAX_SEARCHES_PER_SCAN=2   # 2 searches x (2 + 3 results) fits the 10-credit scan budget
# FIRECRAWL_RESULTS_PER_SEARCH=3
# FIRECRAWL_MAX_CREDITS_PER_SCAN=10
# FIRECRAWL_DAILY_CREDIT_CAP=150
# RESEARCH_MODEL=gpt-4o
# RESEARCH_TOTAL_TIMEOUT_S=240
# RESEARCH_RERANK=false
# RXNAV_ENABLED=true
# SCANS_STORE_SENSITIVE=false       # true keeps rx_number / pharmacy / directions on stored scans
# SHAPE_FILTER_MODE=family          # family | strict | boost
